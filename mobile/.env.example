# Same Firebase project as frontend/.env — copy values from VITE_* to EXPO_PUBLIC_* below.
# Simulator/emulator: localhost or 10.0.2.2. Physical phone: your PC LAN IP.
# Example: EXPO_PUBLIC_BACKEND_URL=http://192.168.1.231:5000
EXPO_PUBLIC_BACKEND_URL=http://localhost:5000

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here

# Optional (not required for email/password auth; web app does not use these either)
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
